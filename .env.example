# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# None of these use the VITE_ prefix on purpose: Vite only ships VITE_*
# variables to the browser, so everything here stays on the server
# (server/index.ts and scripts/mux.ts).

# Mux API access token — dashboard → Settings → Access Tokens.
# Needs Mux Video read + write permissions (and System write to create a
# signing key with `npm run mux -- signing-key`).
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# URL signing key for signed playback. Create one with
# `npm run mux -- signing-key` (prints both values) or in the dashboard.
# MUX_PRIVATE_KEY is the base64-encoded private key exactly as Mux returns it.
MUX_SIGNING_KEY=
MUX_PRIVATE_KEY=

# Playback ID of the lesson video (printed by `npm run mux -- upload <file>`).
MUX_PLAYBACK_ID=

# Optional: a Mux playback restriction (e.g. referrer allowlist for your
# domain) to embed in every token. Leave blank to skip.
MUX_PLAYBACK_RESTRICTION_ID=

# Port for the local token server; Vite proxies /api to it.
API_PORT=8787
